{
  "name": "Danphe EMR",
  // Ubuntu 22.04 on purpose: the plain "ubuntu" image moved to Ubuntu 26.04, which the Docker-in-Docker feature (2.x) refuses to install on
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Danphe EMR - open this to use the system", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/WELCOME.md"] }
  },
  // builds and starts the system (20-40 minutes the first time). If it fails, the codespace still opens and says what to do
  "postStartCommand": "bash docker/start.sh --no-open || echo 'The system did not start - read the messages above, then run:  bash docker/start.sh --no-open'"
}
