# Copy this file to ".env" to change a setting. "Start Danphe EMR" creates .env for you with a private database password.
# The database password is set the first time and must not be changed afterwards (or the application can no longer reach the database).
DB_PASSWORD=Danphe#Local2025
# Password of the 'admin' login (used the first time the system starts; afterwards change it inside the application)
ADMIN_PASSWORD=123
# 1 = start clean (sample staff logins off, sample patients hidden); 0 = keep the sample hospital data
FRESH_START=1
# Address / port the application listens on. 127.0.0.1 = this computer only; 0.0.0.0 = everybody on the network
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
